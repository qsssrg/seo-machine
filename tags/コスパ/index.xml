			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;VPS&lt;/td&gt;
					&lt;td&gt;2コア / 4GB メモリ&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
