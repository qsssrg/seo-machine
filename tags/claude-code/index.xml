&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;&lt;strong&gt;XServer VPS&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;32GB&lt;/td&gt;&lt;td&gt;NVIDIA L4&lt;/td&gt;&lt;td&gt;&lt;span class="check-yes"&gt;○&lt;/span&gt;&lt;/td&gt;&lt;td&gt;要確認&lt;/td&gt;&lt;td&gt;150円/時&lt;/td&gt;&lt;td&gt;4.6/5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;ConoHa VPS&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;60GB&lt;/td&gt;&lt;td&gt;NVIDIA L4&lt;/td&gt;&lt;td&gt;&lt;span class="check-yes"&gt;○&lt;/span&gt;&lt;/td&gt;&lt;td&gt;要確認&lt;/td&gt;&lt;td&gt;178円/時&lt;/td&gt;&lt;td&gt;4.4/5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;さくらのVPS / 高火力&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;192GB&lt;/td&gt;&lt;td&gt;NVIDIA H100 SXM&lt;/td&gt;&lt;td&gt;&lt;span class="check-yes"&gt;○&lt;/span&gt;&lt;/td&gt;&lt;td&gt;要確認&lt;/td&gt;&lt;td&gt;1,320円/時&lt;/td&gt;&lt;td&gt;4.5/5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;KAGOYA CLOUD VPS&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;16GB&lt;/td&gt;&lt;td&gt;なし&lt;/td&gt;&lt;td&gt;&lt;span class="check-yes"&gt;○&lt;/span&gt;&lt;/td&gt;&lt;td&gt;6,600円&lt;/td&gt;&lt;td&gt;11円/時&lt;/td&gt;&lt;td&gt;4.2/5.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Vultr&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;32GB&lt;/td&gt;&lt;td&gt;NVIDIA A16&lt;/td&gt;&lt;td&gt;&lt;span class="check-yes"&gt;○&lt;/span&gt;&lt;/td&gt;&lt;td&gt;要確認&lt;/td&gt;&lt;td&gt;120円/時&lt;/td&gt;&lt;td&gt;4.1/5.0&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
