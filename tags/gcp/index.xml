					&lt;th&gt;VRAM&lt;/th&gt;
					&lt;th&gt;時間単価&lt;/th&gt;
					&lt;th&gt;月額換算（24h×30日）&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;AWS p3.2xlarge&lt;/td&gt;
